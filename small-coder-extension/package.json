{
  "name": "small-coder-extension",
  "displayName": "Small Coder for Visual Studio Code",
  "description": "Un LLM personalizado local para tu VSCode",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:small-coder-extension.setupRuntime",
    "onCommand:small-coder-extension.predict",
    "onCommand:small-coder-extension.forceCpu",
    "onCommand:small-coder-extension.forceCuda",
    "onCommand:small-coder-extension.downloadModel",
    "onCommand:small-coder-extension.openLogs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "small-coder-extension.setupRuntime",
        "title": "SmallCoder: Setup runtime"
      },
      {
        "command": "small-coder-extension.predict",
        "title": "SmallCoder: Predict from cursor"
      },
      {
        "command": "small-coder-extension.forceCpu",
        "title": "SmallCoder: Force CPU"
      },
      {
        "command": "small-coder-extension.forceCuda",
        "title": "SmallCoder: Force CUDA"
      },
      {
        "command": "small-coder-extension.downloadModel",
        "title": "SmallCoder: Download and load model"
      },
      {
        "command": "small-coder-extension.openLogs",
        "title": "SmallCoder: Open runtime logs"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "SmallCoder",
      "properties": {
        "smallCoder.model": {
          "type": "string",
          "default": "smallcoder-tiny",
          "description": "Selected model id for the local inference server"
        },
        "smallCoder.envPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python virtual environment used by SmallCoder"
        },
        "smallCoder.device": {
          "type": "string",
          "enum": [
            "cpu",
            "cuda"
          ],
          "default": "cpu",
          "description": "Device preference for the Python inference server"
        },
        "smallCoder.maxTokens": {
          "type": "number",
          "default": 256,
          "minimum": 1,
          "maximum": 512,
          "description": "Maximum number of tokens to request from the server"
        },
        "smallCoder.serverArgs": {
          "type": "object",
          "default": {},
          "description": "Extra CLI arguments passed to the SmallCoder Python server"
        },
        "smallCoder.autoCreateVenv": {
          "type": "boolean",
          "default": false,
          "description": "Automatically create the SmallCoder virtual environment when setup is triggered"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "keywords": [],
  "authors": [
    "Antonio De León",
    "Juan José Lopera"
  ],
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.74.0",
    "typescript": "^4.9.4"
  }
}
